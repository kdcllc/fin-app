{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fin-app",
  "version": "0.1.1",
  "identifier": "com.kdcllc.finapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kdcllc/fin-app-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5Njk0NDExN0RBQkMxMDcKUldRSHdhdDlFVVJwZVY0cGxnTHdTbXBZWmFWMVhGK3c0S3k5V2xUaXZXUnlydFoyWi8rUkhuQVIK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "fin-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
